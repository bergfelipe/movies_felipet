<% if current_page > 1 %>
  <li class="page-item">
    <%= link_to raw('<i class="bi bi-chevron-left"></i>'), url, class: "page-link", aria: { label: "Anterior" } %>
  </li>
<% else %>
  <li class="page-item disabled">
    <span class="page-link"><i class="bi bi-chevron-left"></i></span>
  </li>
<% end %>
