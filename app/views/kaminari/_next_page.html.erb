<% if current_page < total_pages %>
  <li class="page-item">
    <%= link_to raw('<i class="bi bi-chevron-right"></i>'), url, class: "page-link", aria: { label: "Próxima" } %>
  </li>
<% else %>
  <li class="page-item disabled">
    <span class="page-link"><i class="bi bi-chevron-right"></i></span>
  </li>
<% end %>
