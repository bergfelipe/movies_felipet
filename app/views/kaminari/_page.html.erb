<%# locals: page, url, current_page, total_pages, per_page, remote %>
<% if page.current? %>
  <li class="page-item active" aria-current="page">
    <span class="page-link"><%= page.number %></span>
  </li>
<% else %>
  <li class="page-item">
    <%= link_to page.number, url, class: "page-link" %>
  </li>
<% end %>
