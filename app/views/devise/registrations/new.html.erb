<div class="container d-flex justify-content-center align-items-center" style="min-height: 85vh;">
  <div class="col-md-6 col-lg-5">
    <div class="card shadow border-0 rounded-4">
      <div class="card-body p-4">
 <%= link_to (request.referer || new_session_path(resource_name)), class: "position-absolute top-0 start-0 m-3 text-dark" do %>
  <i class="bi bi-arrow-left fs-5"></i>
<% end %>


        <h2 class="text-center mb-4 fw-bold">
          <i class="bi bi-person-plus-fill text-primary"></i>
          Criar Conta
        </h2>

        <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
          <%= f.error_notification %>

          <div class="mb-3">
            <%= f.input :name, label: "Nome completo", required: true, input_html: { class: "form-control form-control-lg" } %>
          </div>

          <div class="mb-3">
            <%= f.input :email, label: "E-mail", required: true, input_html: { autocomplete: "email", class: "form-control form-control-lg" } %>
          </div>

          <div class="mb-3">
            <%= f.input :password,
                        label: "Senha",
                        required: true,
                        hint: ("Mínimo de #{@minimum_password_length} caracteres" if @minimum_password_length),
                        input_html: { autocomplete: "new-password", class: "form-control form-control-lg" } %>
          </div>

          <div class="mb-4">
            <%= f.input :password_confirmation,
                        label: "Confirmação de senha",
                        required: true,
                        input_html: { autocomplete: "new-password", class: "form-control form-control-lg" } %>
          </div>

          <div class="d-grid mb-3">
            <%= f.button :submit, "Cadastrar", class: "btn btn-primary btn-lg fw-bold shadow-sm" %>
          </div>
        <% end %>

        <hr>

        <div class="text-center">
          <p class="mb-0">Já tem uma conta?
            <%= link_to "Entrar", new_session_path(resource_name), class: "text-decoration-none fw-bold text-primary" %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
