<div class="container d-flex justify-content-center align-items-center" style="min-height: 85vh;">
  <div class="col-md-6 col-lg-5">
    <div class="card shadow border-0 rounded-4">
      <div class="card-body p-4">
        <h2 class="text-center mb-4 fw-bold">
          <i class="bi bi-gear-fill text-primary"></i>
          Editar Perfil
        </h2>

        <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
          <%= f.error_notification %>

          <div class="mb-3">
            <%= f.input :name, label: "Nome completo", required: true, input_html: { class: "form-control form-control-lg" } %>
          </div>

          <div class="mb-3">
            <%= f.input :email, label: "E-mail", required: true, input_html: { class: "form-control form-control-lg" } %>
          </div>

          <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
            <p class="text-muted small">Aguardando confirmação para: <%= resource.unconfirmed_email %></p>
          <% end %>

          <hr>

          <div class="mb-3">
            <%= f.input :password, label: "Nova senha", hint: "Deixe em branco se não quiser alterar", required: false, input_html: { class: "form-control form-control-lg", autocomplete: "new-password" } %>
          </div>

          <div class="mb-3">
            <%= f.input :password_confirmation, label: "Confirmação da nova senha", required: false, input_html: { class: "form-control form-control-lg", autocomplete: "new-password" } %>
          </div>

          <div class="mb-4">
            <%= f.input :current_password, label: "Senha atual", hint: "Necessária para confirmar as alterações", required: true, input_html: { class: "form-control form-control-lg", autocomplete: "current-password" } %>
          </div>

          <div class="d-grid mb-3">
            <%= f.button :submit, "Salvar alterações", class: "btn btn-primary btn-lg fw-bold shadow-sm" %>
          </div>
        <% end %>

        <hr>

        <div class="text-center">
          <%= button_to "Excluir minha conta",
                        registration_path(resource_name),
                        data: { turbo_confirm: "Tem certeza que deseja excluir sua conta permanentemente?" },
                        method: :delete,
                        class: "btn btn-outline-danger w-100" %>

          <div class="mt-3">
            <%= link_to "Voltar", root_path, class: "text-decoration-none text-secondary" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
