<div class="d-flex justify-content-center align-items-center bg-light">
  <div class="card shadow-sm border-0 p-4" style="width: 380px;">
    <h4 class="text-center mb-4 fw-semibold text-dark">Alterar senha</h4>

    <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name),
                        html: { method: :put }) do |f| %>
      <%= f.error_notification %>
      <%= f.input :reset_password_token, as: :hidden %>

      <div class="mb-3">
        <%= f.input :password,
                    label: "Nova senha",
                    input_html: { class: "form-control form-control-sm text-center", autocomplete: "new-password" },
                    required: true %>
      </div>

      <div class="mb-3">
        <%= f.input :password_confirmation,
                    label: "Confirmar senha",
                    input_html: { class: "form-control form-control-sm text-center", autocomplete: "new-password" },
                    required: true %>
      </div>

      <div class="d-grid">
       <%= button_tag type: "submit", class: "btn btn-primary btn-sm w-100" do %>
      <i class="bi bi-lock-fill"></i> Alterar Senha
  <% end %>

      </div>
      <% if notice.present? || alert.present? %>
  <div class="alert <%= notice ? 'alert-success' : 'alert-danger' %> alert-dismissible fade show text-center shadow-sm rounded-3" role="alert">
    <i class="bi <%= notice ? 'bi-check-circle-fill text-success' : 'bi-exclamation-triangle-fill text-danger' %> me-2"></i>
    <%= notice || alert %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>
    <% end %>

    <div class="text-center mt-3 small">
      <%= link_to "Voltar ao login", new_session_path(resource_name), class: "text-decoration-none" %>
    </div>
  </div>
</div>
