<%= form_with(model: filme, class: "card shadow border-0 p-4 mx-auto", style: "max-width: 750px;") do |form| %>
  <% if filme.errors.any? %>
    <div class="alert alert-danger">
      <h5 class="fw-bold mb-2">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <%= t(".erros_titulo", count: filme.errors.count) %>
      </h5>
      <ul class="mb-0">
        <% filme.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row g-3">
    <div class="col-md-6">
      <%= form.label :titulo, t(".titulo"), class: "form-label fw-semibold" %>
      <%= form.text_field :titulo, class: "form-control", placeholder: t(".placeholder_titulo"),id: "filme_titulo", required: true %>

      <small
        id="preencher-ia"
        data-endpoint="<%= preencher_com_ia_filmes_path %>"
        style="cursor:pointer;color:#e83e8c;display:block;margin-top:4px;">
        ✨ <%= t(".preencher resto dos dados com IA") %>
      </small>
      <small id="ia-feedback" class="text-danger" style="display:none;"></small>

    </div>

    <div class="col-md-6">
      <%= form.label :diretor, t(".diretor"), class: "form-label fw-semibold" %>
      <%= form.text_field :diretor, class: "form-control", placeholder: t(".placeholder_diretor"), required: true %>
    </div>

    <div class="col-md-12">
      <%= form.label :sinopse, t(".sinopse"), class: "form-label fw-semibold" %>
      <%= form.text_area :sinopse, class: "form-control", rows: 4, placeholder: t(".placeholder_sinopse"), required: true %>
    </div>

    <div class="col-md-6">
      <%= form.label :ano_lancamento, t(".ano_lancamento"), class: "form-label fw-semibold" %>
      <%= form.select :ano_lancamento,
          options_for_select((1950..Time.current.year + 1).to_a.reverse, filme.ano_lancamento),
          { prompt: t(".selecione_ano") },
          { class: "form-select", required: true } %>
    </div>

    <div class="col-md-6">
      <%= form.label :duracao, t(".duracao"), class: "form-label fw-semibold" %>
      <div class="d-flex align-items-center">
        <%= form.range_field :duracao, in: 60..240, step: 5, class: "form-range me-3", id: "duracao-slider", required: true %>
        <span id="duracao-display" class="fw-semibold text-primary">
          <%= filme.duracao || 120 %> <%= t(".minutos") %>
        </span>
      </div>
      <small class="text-muted"><%= t(".ajuste_duracao") %></small>
    </div>

    <div class="col-md-6">
      <label class="form-label fw-semibold"><%= t(".categorias") %></label>
      <div id="categorias-container">
        <% (filme.categorias.any? ? filme.categorias : [Categoria.new]).each do |categoria| %>
          <div class="categoria-field d-flex mb-2">
            <%= form.collection_select :categoria_ids,
                  Categoria.all,
                  :id,
                  :nome,
                  { prompt: t(".escolha_categoria"), selected: categoria.id },
                  { class: "form-select form-select-sm me-2 categoria-select", name: "filme[categoria_ids][]", required: true } %>

            <button type="button" class="btn btn-sm btn-outline-danger remove-categoria d-flex align-items-center">
              <i class="bi bi-trash3"></i>
            </button>
          </div>
        <% end %>
      </div>

      <button type="button" id="add-categoria" class="btn btn-sm btn-outline-info mt-2 d-flex align-items-center">
        <i class="bi bi-plus-circle me-1"></i> <%= t(".adicionar_categoria") %>
      </button>
    </div>

    <div class="col-md-6 mb-3">
      <%= form.label :poster, t(".poster"), class: "form-label fw-semibold" %>
      <%= form.file_field :poster, class: "form-control form-control-sm" %>
      <% if filme.poster.attached? %>
        <div class="mt-2">
          <%= image_tag(filme.poster.variant(resize_to_limit: [300, 300]), class: "img-thumbnail") %>
        </div>
      <% end %>
    </div>

    <div id="tags-container" class="mb-3">
      <label class="form-label fw-semibold"><%= t(".tags") %></label>
      <div id="tags-list" class="d-flex flex-wrap mb-2">
        <% @filme.tags.each do |tag| %>
          <span class="badge bg-secondary me-2 mb-2 tag-item">
            <%= tag.nome %>
            <button type="button" class="btn btn-sm btn-link text-white p-0 ms-1 remove-tag">&times;</button>
          </span>
        <% end %>
      </div>

      <div class="input-group input-group-sm">
        <input type="text" id="new-tag-input" class="form-control" placeholder="<%= t('.placeholder_tag') %>">
        <button class="btn btn-outline-primary" type="button" id="add-tag-btn">
          <i class="bi bi-plus-circle"></i>
        </button>
      </div>

      <%= hidden_field_tag "filme[tag_list]", @filme.tags.map(&:nome).join(",") %>
    </div>

    <div class="col-12 text-end mt-4">
      <%= form.submit filme.new_record? ? t(".cadastrar_filme") : t(".atualizar_filme"), class: "btn btn-primary px-4" %>
    </div>
  </div>
<% end %>




<script>
 document.addEventListener("DOMContentLoaded", () => {
  const container = document.getElementById("categorias-container");
  const addBtn = document.getElementById("add-categoria");
  const duracaoSlider = document.getElementById("duracao-slider");
  const duracaoDisplay = document.getElementById("duracao-display");

  // Atualiza o texto do slider
  if (duracaoSlider && duracaoDisplay) {
    duracaoSlider.addEventListener("input", () => {
      duracaoDisplay.textContent = `${duracaoSlider.value} min`;
    });
  }

  // Função para evitar categorias duplicadas
  const atualizarOpcoes = () => {
    const selects = container.querySelectorAll("select");
    const selecionados = Array.from(selects).map((s) => s.value).filter((v) => v);
    selects.forEach((select) => {
      Array.from(select.options).forEach((opt) => {
        opt.disabled = selecionados.includes(opt.value) && opt.value !== select.value;
      });
    });
  };

  if (container && addBtn) {
    addBtn.addEventListener("click", () => {
      const firstField = container.querySelector(".categoria-field");
      const clone = firstField.cloneNode(true);
      clone.querySelector("select").value = "";
      container.appendChild(clone);
      atualizarOpcoes();
    });

    container.addEventListener("click", (e) => {
      if (e.target.closest(".remove-categoria")) {
        const allFields = container.querySelectorAll(".categoria-field");
        if (allFields.length > 1) {
          e.target.closest(".categoria-field").remove();
        } else {
          alert("Pelo menos uma categoria é necessária!");
        }
        atualizarOpcoes();
      }
    });

    container.addEventListener("change", atualizarOpcoes);
    atualizarOpcoes();
  }
});



document.addEventListener("DOMContentLoaded", () => {
  const input = document.getElementById("new-tag-input");
  const addBtn = document.getElementById("add-tag-btn");
  const list = document.getElementById("tags-list");
  const hidden = document.querySelector("input[name='filme[tag_list]']");

  const updateHiddenField = () => {
    const tags = Array.from(list.querySelectorAll(".tag-item"))
      .map(el => el.textContent.trim().replace("×", "").trim());
    hidden.value = tags.join(",");
  };

  const addTag = (tagName) => {
    tagName = tagName.trim();
    if (!tagName) return;
    const exists = Array.from(list.querySelectorAll(".tag-item"))
      .some(el => el.textContent.trim().toLowerCase() === tagName.toLowerCase());
    if (exists) return;

    const tag = document.createElement("span");
    tag.className = "badge bg-secondary me-2 mb-2 tag-item";
    tag.innerHTML = `${tagName} <button type="button" class="btn btn-sm btn-link text-white p-0 ms-1 remove-tag">&times;</button>`;
    list.appendChild(tag);
    input.value = "";
    updateHiddenField();
  };

  addBtn.addEventListener("click", () => addTag(input.value));
  input.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      addTag(input.value);
    }
  });

  list.addEventListener("click", (e) => {
    if (e.target.classList.contains("remove-tag")) {
      e.target.closest(".tag-item").remove();
      updateHiddenField();
    }
  });
});


</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const botaoIA = document.querySelector("#preencher-ia");
    const tituloEl = document.querySelector("#filme_titulo");
    const feedback = document.getElementById("ia-feedback");
    if (!botaoIA || !tituloEl) return;
  
    const showErr = (msg) => {
      if (feedback) {
        feedback.textContent = msg;
        feedback.style.display = "block";
      } else {
        alert(msg);
      }
    };
  
    const hideErr = () => {
      if (feedback) feedback.style.display = "none";
    };
  
    botaoIA.addEventListener("click", async (e) => {
      e.preventDefault();
  
      const titulo = (tituloEl.value || "").trim();
      if (!titulo) return showErr("Digite um título primeiro!");
  
      const endpoint = botaoIA.dataset.endpoint;
      const csrf = document.querySelector("meta[name='csrf-token']")?.content;
  
      botaoIA.style.pointerEvents = "none";
      const original = botaoIA.textContent;
      botaoIA.textContent = "⏳ Pensando...";
  
      try {
        const resp = await fetch(endpoint, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json",
            "X-CSRF-Token": csrf
          },
          body: JSON.stringify({ titulo })
        });
  
        const data = await resp.json().catch(() => ({}));
        console.log("Resposta IA:", data);
  
        if (!resp.ok || data.error) {
          showErr(data.error || "Erro inesperado da IA.");
          botaoIA.textContent = original;
          return;
        }
  
        // limpa mensagens de erro
        hideErr();
  
        const byId = id => document.getElementById(id);
  
        // === CAMPOS ===
        byId("filme_sinopse") && (byId("filme_sinopse").value = data.sinopse || "");
        byId("filme_ano_lancamento") && (byId("filme_ano_lancamento").value = data.ano_lancamento || "");
        byId("filme_diretor") && (byId("filme_diretor").value = data.diretor || "");
  
        // === DURAÇÃO COM SLIDER ===
        const duracaoSlider = document.getElementById("duracao-slider");
        const duracaoDisplay = document.getElementById("duracao-display");
        if (duracaoSlider && data.duracao) {
          const min = parseInt(duracaoSlider.min || "60", 10);
          const max = parseInt(duracaoSlider.max || "240", 10);
          const valor = Math.max(min, Math.min(max, parseInt(data.duracao, 10)));
          duracaoSlider.value = valor;
          duracaoDisplay.textContent = `${valor} min`;
        }
  
        // === CATEGORIAS ===
        const sel = byId("filme_categoria_ids");
        if (sel && Array.isArray(data.categorias)) {
          const nomes = data.categorias.map(c => String(c).toLowerCase());
          for (const opt of sel.options) {
            const txt = opt.text.toLowerCase();
            opt.selected = nomes.some(n => txt.includes(n));
          }
        }
  
        botaoIA.textContent = "✨ Dados preenchidos!";
        setTimeout(() => (botaoIA.textContent = original), 2000);
      } catch (err) {
        console.error("Erro no fetch:", err);
        showErr("Erro na comunicação com o servidor.");
        botaoIA.textContent = original;
      } finally {
        botaoIA.style.pointerEvents = "auto";
      }
    });
  
    // === SLIDER listener padrão ===
    const duracaoSlider = document.getElementById("duracao-slider");
    const duracaoDisplay = document.getElementById("duracao-display");
    if (duracaoSlider && duracaoDisplay) {
      duracaoSlider.addEventListener("input", () => {
        duracaoDisplay.textContent = `${duracaoSlider.value} min`;
      });
    }
  });
  </script>
  



