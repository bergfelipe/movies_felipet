<!DOCTYPE html>
<html>
  <head>
    <title>Catálogo de Filmes</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- ✅ Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous">

    <!-- ✅ Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <!-- ✅ Font Awesome (mais ícones) -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
      integrity="sha512-Mm0R+f6mZ3Fv2TQydF+iRkaZFTu0e9iyO8Q1rYXc/0zEbRjZZp7r2E4d3vN3zTFSzD9R1Kv6mJkMewZbYFv8cw=="
      crossorigin="anonymous" referrerpolicy="no-referrer" />

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
  </head>

  <body class="bg-light d-flex flex-column min-vh-100">
    <!-- ✅ Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <%= link_to "🎬 Felipet Movies", root_path, class: "navbar-brand fw-bold" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <% if user_signed_in? %>
              <li class="nav-item">
                <span class="nav-link">👤 <%= current_user.name.presence || current_user.email %></span>
              </li>
              <li class="nav-item"><%= link_to "Novo Filme", new_filme_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "Sair", destroy_user_session_path, method: :delete, data: { turbo: false }, class: "nav-link" %></li>
            <% else %>
              <li class="nav-item"><%= link_to "Entrar", new_user_session_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "Cadastrar", new_user_registration_path, class: "nav-link" %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <!-- ✅ Flash messages -->
    <div class="container mt-3">
      <% flash.each do |type, msg| %>
        <% bootstrap_class = case type.to_sym
          when :notice then "alert-success"
          when :alert then "alert-danger"
          else "alert-info"
        end %>
        <div class="alert <%= bootstrap_class %> alert-dismissible fade show" role="alert">
          <%= msg %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>
    </div>

    <!-- ✅ Main content -->
    <main class="container my-4 flex-grow-1">
      <%= yield %>
    </main>

    <!-- ✅ Footer -->
    <footer class="bg-dark text-white text-center py-3 mt-auto">
      <small>Desenvolvido por <strong>Felipe</strong> — <%= Time.now.year %></small>
    </footer>

    <!-- ✅ Bootstrap JS (com Popper) -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"></script>
  </body>
</html>
