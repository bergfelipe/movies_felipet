<!DOCTYPE html>
<html>
  <head>
    <title>MoviesFelipet</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
  <p class="notice"><%= notice %></p>
<p class="alert"><%= alert %></p>

<nav>
  <% if user_signed_in? %>
    Olá, <%= current_user.name.presence || current_user.email %> |
    <%= link_to "Meu perfil", edit_user_registration_path %> |
    <%= link_to "Sair", destroy_user_session_path, method: :delete, data: { turbo: false } %>
  <% else %>
    <%= link_to "Entrar", new_user_session_path %> |
    <%= link_to "Cadastrar", new_user_registration_path %>
  <% end %>
</nav>
<hr>

    <%= yield %>
  </body>
</html>
